# Development image: runs `nuxt dev` with the repository mounted at /app (see docker-compose.devci.yml)
FROM node:22.23.2-bookworm-slim
WORKDIR /app

ARG ENVIRONMENT=localhost
ARG APP_BASE_URL=http://localhost:3001
ARG OEB_LEGACY_ANGULAR_URI=https://legacy.openebench.bsc.es/
ARG VRE_URI=https://openebench.bsc.es/vre/home/
ARG OBSERVATORY_URI=https://observatory.openebench.bsc.es
ARG REST_API_URL=https://openebench.bsc.es/monitor/rest/
ARG SCIENTIFIC_SERVICE_URL=https://test-oeb2.openebench.bsc.es/api/scientific
ARG SCIENTIFIC_SERVICE_URL_API=https://test-oeb2.openebench.bsc.es/api/scientific/
ARG BENCH_EVENT_API_URL=https://openebench.bsc.es/rest/bench_event_api
ARG KEYCLOAK_HOST=https://inb.bsc.es
ARG KEYCLOAK_REALM=oeb2dev
ARG KEYCLOAK_CLIENT_ID=oeb-frontend
ARG OBSERVATORY_API_URL=https://observatory.openebench.bsc.es/api
ARG GITHUBAPP_API_URL=https://observatory.openebench.bsc.es/github-metadata-api

ENV ENVIRONMENT=$ENVIRONMENT \
    OEB_LEGACY_ANGULAR_URI=$OEB_LEGACY_ANGULAR_URI \
    VRE_URI=$VRE_URI \
    OBSERVATORY_URI=$OBSERVATORY_URI \
    REST_API_URL=$REST_API_URL \
    SCIENTIFIC_SERVICE_URL=$SCIENTIFIC_SERVICE_URL \
    SCIENTIFIC_SERVICE_URL_API=$SCIENTIFIC_SERVICE_URL_API \
    BENCH_EVENT_API_URL=$BENCH_EVENT_API_URL \
    KEYCLOAK_HOST=$KEYCLOAK_HOST \
    KEYCLOAK_REALM=$KEYCLOAK_REALM \
    KEYCLOAK_CLIENT_ID=$KEYCLOAK_CLIENT_ID \
    OBSERVATORY_API_URL=$OBSERVATORY_API_URL \
    GITHUBAPP_API_URL=$GITHUBAPP_API_URL \
    APP_BASE_URL=$APP_BASE_URL \
    AUTH_ORIGIN=$APP_BASE_URL
# NUXT_AUTH_SECRET is provided at runtime (see docker-compose.devci.yml)

COPY . .
# node_modules must be writable by the non-root user set via DEV_UID/DEV_GID in docker-compose.devci.yml
RUN npm install --global npm@12.0.2 && npm ci && chmod -R a+rwX /app/node_modules
ENV npm_config_cache=/tmp/.npm

EXPOSE 3001
CMD ["npm", "run", "dev"]
