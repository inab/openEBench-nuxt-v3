{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "predev": "nuxt cleanup",
    "start": "nuxt start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt cleanup && nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{components,pages,plugins,middleware,layouts,composables,assets}/**/*.{js,jsx,ts,tsx,vue,html,css,scss,json,md}\"",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.8.0 <11"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^7.3.0",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-brands-svg-icons": "6.7.2",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/vue-fontawesome": "3.0.8",
    "@inb/oeb-widgets-graphs": "^1.0.9",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "^2.21.0",
    "@pinia/nuxt": "0.5.4",
    "@sidebase/nuxt-auth": "0.8.1",
    "@vuepic/vue-datepicker": "^9.0.3",
    "aos": "^2.3.4",
    "bootstrap": "5.3.3",
    "ckeditor5": "^48.5.0",
    "data-urls": "5.0.0",
    "dompurify": "3.4.15",
    "gsap": "^3.12.5",
    "lodash.debounce": "4.0.8",
    "marked": "13.0.2",
    "next-auth": "4.21.1",
    "nodemailer": "6.10.1",
    "nuxt": "3.21.11",
    "nuxt-viewport": "2.1.5",
    "pinia": "2.2.2",
    "plotly.js-dist": "^2.35.2",
    "pluralize": "8.0.0",
    "turndown": "^7.2.0",
    "unicorn-magic": "0.3.0",
    "v-calendar": "^3.1.2",
    "valibot": "^1.0.0",
    "vite-svg-loader": "5.1.0",
    "vue": "3.5.13",
    "vue-multiselect": "3.1.0",
    "vue-observe-visibility": "2.0.0-alpha.1",
    "vue3-carousel": "0.3.3",
    "vue3-carousel-nuxt": "1.1.2",
    "whatwg-encoding": "3.1.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.4.0",
    "@nuxt/test-utils": "3.23.0",
    "@nuxt/types": "^2.18.1",
    "@pinia/testing": "0.1.5",
    "@types/data-urls": "3.0.4",
    "@types/pluralize": "0.0.33",
    "@types/whatwg-encoding": "2.0.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-istanbul": "3.2.4",
    "@vitest/ui": "5.0.0",
    "@vue/runtime-core": "^3.5.12",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "happy-dom": "14.12.3",
    "husky": "^9.1.6",
    "jsdom": "24.1.3",
    "lint-staged": "^15.2.10",
    "msw": "^2.4.11",
    "prettier": "^3.3.3",
    "sass": "1.77.6",
    "sass-loader": "14.2.1",
    "typescript": "^5.5.4",
    "vitest": "3.2.4",
    "webpack": "5.92.1"
  },
  "overrides": {
    "vue": "3.5.13"
  }
}
