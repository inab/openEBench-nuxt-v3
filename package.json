{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "cleanup": "nuxt cleanup",
    "start": "nuxt start",
    "test": "vitest",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt cleanup && nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,vue,html,css,scss,json,md}\"",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=12.0.2 <13"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^9.0.0",
    "@exodus/bytes": "^1.16.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@inb/oeb-widgets-graphs": "^1.0.9",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "^4.12.0",
    "@pinia/nuxt": "^1.0.3",
    "@popperjs/core": "^2.11.8",
    "@sidebase/nuxt-auth": "0.8.1",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/devtools-api": "^8.2.1",
    "@vuepic/vue-datepicker": "^14.0.0",
    "aos": "^2.3.4",
    "bootstrap": "5.3.8",
    "ckeditor5": "^49.0.0",
    "data-urls": "^8.0.0",
    "dompurify": "^3.4.17",
    "gsap": "^3.12.5",
    "lodash.debounce": "4.0.8",
    "marked": "^18.1.1",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.1.7",
    "nuxt": "^4.5.2",
    "pinia": "^4.1.0",
    "plotly.js-dist": "^4.1.2",
    "pluralize": "8.0.0",
    "turndown": "^7.2.0",
    "unicorn-magic": "0.3.0",
    "v-calendar": "^3.1.2",
    "valibot": "^1.0.0",
    "vite-svg-loader": "^5.1.3",
    "vue": "3.5.44",
    "vue-multiselect": "^3.5.0",
    "vue-observe-visibility": "2.0.0-alpha.1",
    "vue3-carousel": "^0.19.0",
    "vue3-carousel-nuxt": "^1.1.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@pinia/testing": "^2.0.2",
    "@types/data-urls": "^3.0.5",
    "@types/pluralize": "0.0.33",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.6",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "sass": "^1.106.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "vue": "3.5.44",
    "tar": "7.5.22"
  }
}
