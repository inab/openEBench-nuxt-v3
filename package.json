{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "cleanup": "nuxt cleanup",
    "start": "nuxt start",
    "test": "vitest",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt cleanup && nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,vue,html,css,scss,json,md}\"",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=12.0.2 <13"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^7.3.0",
    "@exodus/bytes": "1.15.1",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-brands-svg-icons": "6.7.2",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@inb/oeb-widgets-graphs": "^1.0.9",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.11.2",
    "@pinia/nuxt": "^1.0.2",
    "@popperjs/core": "^2.11.8",
    "@sidebase/nuxt-auth": "0.8.1",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/devtools-api": "^8.2.1",
    "@vuepic/vue-datepicker": "^9.0.3",
    "aos": "^2.3.4",
    "bootstrap": "5.3.8",
    "ckeditor5": "^48.5.0",
    "data-urls": "5.0.0",
    "dompurify": "3.4.15",
    "gsap": "^3.12.5",
    "lodash.debounce": "4.0.8",
    "marked": "13.0.2",
    "next-auth": "4.21.1",
    "nodemailer": "10.0.10",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "plotly.js-dist": "^2.35.2",
    "pluralize": "8.0.0",
    "turndown": "^7.2.0",
    "unicorn-magic": "0.3.0",
    "v-calendar": "^3.1.2",
    "valibot": "^1.0.0",
    "vite-svg-loader": "5.1.0",
    "vue": "3.5.43",
    "vue-multiselect": "3.1.0",
    "vue-observe-visibility": "2.0.0-alpha.1",
    "vue3-carousel": "0.15.1",
    "vue3-carousel-nuxt": "^1.1.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@pinia/testing": "^2.0.1",
    "@types/data-urls": "3.0.4",
    "@types/pluralize": "0.0.33",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-istanbul": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "happy-dom": "20.14.5",
    "husky": "^9.1.6",
    "jsdom": "27.4.0",
    "lint-staged": "^15.2.10",
    "msw": "^2.4.11",
    "prettier": "^3.9.8",
    "sass": "1.104.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vue": "3.5.43",
    "tar": "7.5.22"
  }
}
