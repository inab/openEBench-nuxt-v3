# Secret used by next-auth to sign/encrypt session cookies (runtime only, never commit the real value).
# Generate one per environment with: openssl rand -hex 32
NUXT_AUTH_SECRET=<openssl rand -hex 32>

# Your user and group ids (run `id -u` and `id -g`), so files created by the Docker dev
# container are not owned by root. Without them the container runs as root.
DEV_UID=1000
DEV_GID=1000
