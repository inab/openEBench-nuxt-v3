# Build stage
FROM node:22.23.4-alpine AS build
WORKDIR /app

COPY package*.json .npmrc ./
RUN npm install --global npm@12.0.2
RUN npm ci

COPY . .
RUN npm run build
# Workaround: nuxt-auth imports next-auth/core and next-auth/jwt through subpaths that next-auth 4.24 does not export; use relative paths to the traced copy
RUN grep -rlE "next-auth/(core|jwt)'" .output/server/chunks | xargs -r sed -i -E "s#next-auth/(core|jwt)'#../../../../node_modules/next-auth/\1/index.js'#g"

# Runtime stage
# Runtime configuration is not baked in: the browser and server read /app/config/config.json at start-up;
# mount your own file over it (see README). NUXT_AUTH_SECRET must also be provided at runtime.
FROM node:22.23.4-alpine
WORKDIR /app
ENV NITRO_PORT=3000 \
    NITRO_HOST=0.0.0.0
COPY --from=build /app/.output /app/.output
COPY config/config.json /app/config/config.json
# The traced next-auth lacks the core/ files (and their deps) that nuxt-auth imports
COPY --from=build /app/node_modules/next-auth/package.json /tmp/next-auth-package.json
RUN NA_VERSION=$(node -p "require('/tmp/next-auth-package.json').version") \
    && mkdir /tmp/na && cd /tmp/na && npm init -y >/dev/null \
    && npm install --omit=dev --no-audit --no-fund next-auth@$NA_VERSION \
    && rm -rf /app/.output/server/node_modules/next-auth \
    && cp -r /tmp/na/node_modules/* /app/.output/server/node_modules/ \
    && rm -rf /tmp/na /tmp/next-auth-package.json

EXPOSE 3000

CMD ["node", "/app/.output/server/index.mjs"]
